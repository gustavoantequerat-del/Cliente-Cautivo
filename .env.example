# ------------------------------------------------------------------
# Portal Cliente Cautivo · configuración
# Local: DB_CONNECTION=sqlite (sin más datos).  cPanel: MySQL (abajo).
# ------------------------------------------------------------------
APP_NAME="Portal Cliente"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL creado en cPanel > Bases de datos MySQL (usuario con TODOS los privilegios)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_portal
DB_USERNAME=cpaneluser_portal
DB_PASSWORD=

# Sin Redis ni procesos persistentes: todo va a la base de datos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Correo de la cuenta cPanel (Cuentas de correo > Conectar dispositivos)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.tudominio.com
MAIL_PORT=465
MAIL_USERNAME=portal@tudominio.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="portal@tudominio.com"
MAIL_FROM_NAME="Portal Cliente Blockfinity"

# Portal
PORTAL_NOTIFY_EMAIL=clientsuccess@tudominio.com
PORTAL_MAX_UPLOAD_KB=10240

VITE_APP_NAME="${APP_NAME}"
